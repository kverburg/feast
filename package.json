{
  "name": "feast",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:worker": "vite build && wrangler dev --test-scheduled",
    "test": "esbuild tests/*.test.mjs --bundle --platform=node --format=esm --outdir=.test-out --log-level=error && node --test .test-out/*.test.js",
    "bench": "esbuild bench/run.mjs --bundle --platform=node --format=esm --outfile=.bench-out/run.mjs --log-level=error && node .bench-out/run.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
