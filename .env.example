# Copy to .env.local (ignored by git) for local development.
# Used only by the dev server's /api/gemini proxy; it is never bundled into the app.
# Use your DEV key here, not the production one.
GEMINI_API_KEY=

# Optional: override the models (defaults are in worker/gemini.js)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_LIGHT=gemini-flash-lite-latest

# Optional: run the AI work on Mistral instead (default is gemini). AI_PROVIDER_LIGHT is for annotation.
# AI_PROVIDER=mistral
# AI_PROVIDER_LIGHT=mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MODEL_LIGHT=mistral-small-latest
